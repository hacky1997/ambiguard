# AmbiGuard configuration
# The app MUST boot with ALL of these empty or absent.
# Every external dependency degrades gracefully.

# --- Gate checkpoint (optional — falls back to heuristic gate) ---
# GATE_CHECKPOINT_PATH=
# GATE_HF_REPO=

# --- LLM provider (default: mock — no key needed) ---
# LLM_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Eval ---
# EVAL_BOOTSTRAP_RESAMPLES=10000
# EVAL_DETERMINISM_RUNS=3
